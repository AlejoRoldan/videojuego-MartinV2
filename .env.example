# Local sample: optional; the server defaults to data/live-rooms.db.
DATABASE_URL=file:/absolute/path/to/data/live-rooms.db

# Required only when DATABASE_URL points to a protected remote libSQL database.
DATABASE_AUTH_TOKEN=

# Set to false to hide remote rooms while keeping local and link challenges available.
VITE_REMOTE_ROOMS_ENABLED=true

# Production server port.
PORT=3000
